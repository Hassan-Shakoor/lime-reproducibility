  "cards": [
    {
      "dot": "cyan",
      "title": "Each dataset has its own classifier",
      "items": [
        "Iris uses RandomForestClassifier with 500 trees on the bundled sklearn table",
        "20 Newsgroups uses TfidfVectorizer + Multinomial Naive Bayes, not the Iris forest",
        "UCI Heart Disease (Cleveland, 303 rows) trains a separate RF with 300 trees"
      ]
    },
    {
      "dot": "violet",
      "title": "Project datasets for the video",
      "items": [
        "Heart Disease is downloaded from the UCI ML Repository, then explained with LimeTabularExplainer",
        "The constructed corpus injects header-style artefacts at 5 intensity levels, then fits logistic regression",
        "Both project paths still only hand LIME a predict_proba function"
      ]
    },
    {
      "dot": "rose",
      "title": "Text path has a real SSL gate",
      "items": [
        "First 20 Newsgroups fetch failed on macOS Python.org with CERTIFICATE_VERIFY_FAILED",
        "The text script sets SSL_CERT_FILE from certifi before fetch_20newsgroups",
        "Iris never hits the network; Heart Disease hits archive.ics.uci.edu"
      ]
    },
    {
      "dot": "amber",
      "title": "LIME never opens the model",
      "items": [
        "explain_instance only needs predict_proba on a raw instance",
        "The engine perturbs a neighborhood, then calls that same function on the synthetic rows",
        "LimeBase fits a weighted Ridge; default neighborhood size is 5000 samples"
      ]
    }
  ]
